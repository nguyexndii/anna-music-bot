# Discord Bot Credentials
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
DISCORD_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Server Port for 24/7 Keep-Alive Health Check
PORT=3000

# Default 24/7 Stream URL (Optional: Default is Lofi Girl 24/7 stream)
DEFAULT_247_STREAM=https://www.youtube.com/watch?v=jfKfPfyJRdk

# Last.fm API Key (Optional - Fallback lớp 2 cho Autoplay gợi ý bài hát tương tự)
# Lấy API Key miễn phí tại: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Google Gemini AI API Keys (Optional - Trợ lý DJ Gemini AI gợi ý nhạc & tìm nhạc theo ngôn ngữ tự nhiên)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey (Hỗ trợ nhiều key cách nhau bằng dấu phẩy)
GEMINI_API_KEYS=

# MongoDB Atlas URI (Lưu trữ danh sách bài yêu thích, lịch sử 20 bài chống lặp, session 24/7)
MONGODB_URI=

# Secret key ký Web Token (Hỗ trợ cả WEB_JWT_SECRET hoặc WEB_TOKEN_SECRET)
WEB_JWT_SECRET=
WEB_TOKEN_SECRET=

# Microservice Fallback Lyrics đa nguồn (FastAPI + syncedlyrics chạy cổng nội bộ)
LYRICS_FALLBACK_URL=http://127.0.0.1:8787/lyrics

# Danh sách ID các máy chủ được phép sử dụng bot (Private / Whitelist Multi-Guild, phân cách bằng dấu phẩy)
# Ví dụ: ALLOWED_GUILD_IDS=guildId_chinh,guildId_test
ALLOWED_GUILD_IDS=

# ID tài khoản Discord của Quản trị viên tối cao (Bot Owner)
ADMIN_USER_ID=

# Số luồng trích xuất âm thanh yt-dlp tối đa chạy đồng thời (Mặc định: 2)
MAX_CONCURRENT_EXTRACTION=2
